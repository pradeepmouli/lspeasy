{
  "name": "@lsproxy/proxy",
  "version": "1.0.0",
  "description": "Per-root LSP multiplexing daemon — holds warm language server connections for @lsproxy/cli",
  "type": "module",
  "bin": {
    "lsps": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsgo --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "@lspeasy/client": "workspace:*",
    "@lspeasy/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
