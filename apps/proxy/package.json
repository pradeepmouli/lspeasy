{
  "name": "@lsproxy/proxy",
  "version": "1.0.2",
  "description": "Per-root LSP multiplexing daemon \u2014 holds warm language server connections for @lsproxy/cli",
  "private": false,
  "keywords": [
    "lsp",
    "language-server-protocol",
    "lsp-proxy",
    "language-server",
    "cli"
  ],
  "homepage": "https://github.com/pradeepmouli/lspeasy#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/lspeasy/issues"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/lspeasy.git",
    "directory": "apps/proxy"
  },
  "type": "module",
  "bin": {
    "lsps": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@lspeasy/client": "workspace:*",
    "@lspeasy/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
