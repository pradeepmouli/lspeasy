{
  "name": "@lspeasy/server",
  "version": "4.1.5",
  "description": "Build LSP language servers with a simple, fully-typed API",
  "private": false,
  "keywords": [
    "lsp",
    "language-server-protocol",
    "lsp-server",
    "language-server"
  ],
  "homepage": "https://github.com/pradeepmouli/lspeasy#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/lspeasy/issues"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/lspeasy.git",
    "directory": "packages/server"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsgo --build --watch",
    "type-check": "tsgo -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@lspeasy/core": "workspace:*",
    "camelcase": "^9.0.0"
  },
  "optionalDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vscode-languageserver-protocol": "^3.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
