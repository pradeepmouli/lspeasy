{
  "name": "@lspeasy/core",
  "version": "3.0.0",
  "description": "Core types, transports, and utilities for LSP SDK",
  "private": false,
  "keywords": [
    "lsp",
    "language-server-protocol",
    "jsonrpc",
    "transport"
  ],
  "homepage": "https://github.com/pradeepmouli/lspeasy#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/lspeasy/issues"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/lspeasy.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/internal": {
      "types": "./dist/utils/internal.d.ts",
      "import": "./dist/utils/internal.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./protocol/enums": {
      "types": "./dist/protocol/enums.d.ts",
      "import": "./dist/protocol/enums.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./transport/websocket": {
      "types": "./dist/transport/websocket.d.ts",
      "import": "./dist/transport/websocket.js"
    },
    "./transport/dedicated-worker": {
      "types": "./dist/transport/dedicated-worker.d.ts",
      "import": "./dist/transport/dedicated-worker.js"
    },
    "./transport/shared-worker": {
      "types": "./dist/transport/shared-worker.d.ts",
      "import": "./dist/transport/shared-worker.js"
    },
    "./transport/events": {
      "types": "./dist/transport/events.d.ts",
      "import": "./dist/transport/events.js"
    },
    "./transport/stdio": {
      "types": "./dist/transport/stdio.d.ts",
      "import": "./dist/transport/stdio.js"
    },
    "./transport/tcp": {
      "types": "./dist/transport/tcp.d.ts",
      "import": "./dist/transport/tcp.js"
    },
    "./transport/ipc": {
      "types": "./dist/transport/ipc.d.ts",
      "import": "./dist/transport/ipc.js"
    },
    "./transport/socket": {
      "types": "./dist/transport/socket.d.ts",
      "import": "./dist/transport/socket.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc --build --watch",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "ws": "^8.20.1"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
